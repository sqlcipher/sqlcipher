# This file implements regression tests for SQLite library.  The
# focus of this script is testing code cipher features.
#
# NOTE: tester.tcl has overridden the definition of sqlite3 to
# automatically pass in a key value. Thus tests in this file
# should explicitly close and open db with sqlite_orig in order
# to bypass default key assignment.

set testdir [file dirname $argv0]
source $testdir/tester.tcl
source $testdir/sqlcipher.tcl

# Test rekey as first operation on an empty database
# it should raise an error
do_test rekey-as-first-op-on-empty {
  sqlite_orig db test.db

  catchsql "
    PRAGMA rekey = $hexkey;
  "

} {1 {An error occurred with PRAGMA key or rekey.}}
db close
file delete -force test.db

# test a rekey operation as the first op on an existing database
# then test that now the new key opens the database
# now close database re-open with new key
setup test.db "$hexkey"
do_test rekey-as-first-operation {
  sqlite_orig db test.db
  execsql "
    PRAGMA key = $hexkey;
    PRAGMA rekey = 'testkeynew';
  "
  db close

  sqlite_orig db test.db
  execsql {
    PRAGMA key = 'testkeynew';
    SELECT name FROM sqlite_schema WHERE type='table';
  }
} {ok t1}
db close
file delete -force test.db

# same as previous, use hexrekey
setup test.db "$hexkey"
do_test hexrekey-as-first-operation {
  sqlite_orig db test.db
  execsql "
    PRAGMA key = $hexkey;
    PRAGMA hexrekey = '746573746b65796e6577';
  "
  db close

  sqlite_orig db test.db
  execsql {
    PRAGMA key = 'testkeynew';
    SELECT name FROM sqlite_schema WHERE type='table';
  }
} {ok t1}
db close
file delete -force test.db

# same as previous, use textrekey
setup test.db "$hexkey"
do_test textrekey-as-first-operation {
  sqlite_orig db test.db
  execsql "
    PRAGMA key = $hexkey;
    PRAGMA textrekey = 'testkeynew';
  "
  db close

  sqlite_orig db test.db
  execsql {
    PRAGMA key = 'testkeynew';
    SELECT name FROM sqlite_schema WHERE type='table';
  }
} {ok t1}
db close
file delete -force test.db

# create a new database, insert some data
# then rekey it with the same password
do_test rekey-same-passkey {
  sqlite_orig db test.db

  execsql "
    PRAGMA key = $hexkey;
    CREATE TABLE t1(a,b);
    WITH RECURSIVE counter(x) AS (VALUES (1) UNION SELECT x+1 FROM counter WHERE x < 500)
      INSERT INTO t1(a,b) SELECT x, zeroblob(5000) FROM counter;
  "
  execsql "
    SELECT count(*) FROM t1;
    PRAGMA cache_size = 0;
    PRAGMA rekey = $hexkey;
    SELECT count(*) FROM t1;
  "
} {500 ok 500}
db close
file delete -force test.db

# create a new database, insert some data
# then rekey it. Make sure it is immediately
# readable. Then close it and make sure it can be
# read back 
do_test rekey-and-query-1 {
  sqlite_orig db test.db

  execsql "
    PRAGMA key = $hexkey;
    CREATE TABLE t1(a,b);
    WITH RECURSIVE counter(x) AS (VALUES (1) UNION SELECT x+1 FROM counter WHERE x < 500)
      INSERT INTO t1(a,b) SELECT x, zeroblob(5000) FROM counter;
  "

  execsql "
    SELECT count(*) FROM t1;
    PRAGMA cache_size = 0;
    PRAGMA rekey = $hexkey2;
    SELECT count(*) FROM t1;
  "
} {500 ok 500}

db close

do_test rekey-and-query-2 {
  sqlite_orig db test.db
  execsql "
    PRAGMA key = $hexkey2;
    SELECT count(*) FROM t1;
  "
} {ok 500}
db close
file delete -force test.db

# create a new database, insert some data
# delete about 50% of the data
# write some new data
# delete another 50%
# then rekey it. Make sure it is immediately
# readable. Then close it and make sure it can be
# read back. This test will ensure that Secure Delete
# is enabled and all pages are being written and are not
# being optimized out by sqlite3PagerDontWrite
foreach mode {delete wal} {
  do_test rekey-delete-and-query-1-$mode {
    sqlite_orig db test.db

    execsql "
      PRAGMA key = $hexkey;
      PRAGMA journal_mode = $mode;
      CREATE TABLE t1(a,b);
      CREATE INDEX ta_a ON t1(a);
      BEGIN;
      WITH RECURSIVE counter(x) AS (VALUES (1) UNION SELECT x+1 FROM counter WHERE x < 500)
        INSERT INTO t1(a,b) SELECT x, zeroblob(5000) FROM counter;
    "

    execsql "DELETE FROM t1 WHERE a < 250;"

    set r1 [expr {int(rand()*32767)}]
    execsql "UPDATE t1 SET b = $r1 WHERE a < 375;"

    execsql "DELETE FROM t1 WHERE a > 375;"

    execsql {
      COMMIT;
      SELECT (count(*) > 0) FROM t1;
    }
  } {1}
  db close

  do_test rekey-delete-and-query-2-$mode {
    sqlite_orig db test.db
    execsql "
      PRAGMA key = $hexkey;
      PRAGMA cache_size = 0;
      PRAGMA rekey = $hexkey2;
      SELECT count(*) > 1 FROM t1;
      PRAGMA integrity_check;
    "
  } {ok ok 1 ok}
  db close

  do_test rekey-delete-and-query-3-$mode {
    sqlite_orig db test.db
    execsql "
      PRAGMA key = $hexkey2;
      SELECT count(*) > 1 FROM t1;
      PRAGMA journal_mode;
    " 
  } "ok 1 $mode"
  db close
  file delete -force test.db
}

do_test rekey-database-by-name {
    sqlite_orig db test.db
    execsql {
        attach database 'new.db' as new;
        pragma new.key = 'foo';
        create table new.t1(a,b);
        insert into new.t1(a,b) values('foo', 'bar');
        pragma new.rekey = 'bar';
        detach database new;
    }
    db close

    sqlite_orig db new.db
    execsql {
        pragma key = 'bar';
        select * from t1;
    }
} {ok foo bar}
db close
file delete -force test.db
file delete -force new.db

# create a new database, insert multiple pages of data
# set the cache size to zero to make sure writes
# are immediately written, set the error flag
# and allow it to rollback. 
foreach mode {delete wal} {
  do_test rekey-error-$mode {
    sqlite_orig db test.db

    set rc {}

    execsql "
      PRAGMA key = $hexkey;
      PRAGMA journal_mode = $mode;
      CREATE TABLE t1(a,b);
      WITH RECURSIVE counter(x) AS (VALUES (1) UNION SELECT x+1 FROM counter WHERE x < 500)
        INSERT INTO t1(a,b) SELECT x, zeroblob(5000) FROM counter;
      PRAGMA wal_checkpoint(TRUNCATE);
    "

    lappend rc [execsql {
      SELECT count(*) FROM t1;
    }]

    execsql {
      PRAGMA cipher_test_on = fail_rekey;
    }
    
    lappend rc [catchsql "
      PRAGMA cache_size = 0;
      PRAGMA rekey = $hexkey2;
    "]

    db close
    sqlite_orig db test.db

    # the transaction should have been rolled back
    # so the old key should work
    lappend rc [execsql "
      PRAGMA key = $hexkey;
      SELECT count(*) FROM t1;
      PRAGMA integrity_check;
      PRAGMA cipher_integrity_check;
      PRAGMA cipher_test_off = fail_rekey;
    "]

  } {500 {1 {An error occurred with PRAGMA key or rekey.}} {ok 500 ok}}
  db close
  file delete -force test.db
}

# explicitly verify that if a rekey fails at the onset due to
# a read only database, that an error is reported and
# the key is unchanged
do_test rekey-readonly {
  set rc {}

  sqlite_orig db test.db
  execsql "
    PRAGMA key = $hexkey;
    CREATE TABLE t1(a,b);
    INSERT INTO t1 VALUES(1, 2);
  "
  db close

  sqlite_orig db file:test.db?mode=ro
  lappend rc [ catchsql "
    PRAGMA key = $hexkey;
    PRAGMA rekey = 'test2';
  "] 
  db close

  sqlite_orig db test.db
  lappend rc [ catchsql {
    PRAGMA key = 'test2';
    SELECT * FROM t1;
  }]

  lappend rc [ execsql "
    PRAGMA key = $hexkey;
    SELECT * FROM t1;
  "]
  set rc
} {{1 {An error occurred with PRAGMA key or rekey.}} {1 {file is not a database}} {ok 1 2}}
db close
file delete -force test.db

# when run inder the test fixure, default page size of
# non-encrypted databases is 1024. If this
# ever changes in the SQLite test fixture this
# test will fail
do_test rekey-default-page-size {
  sqlite_orig db test.db

  execsql {
    CREATE TABLE t1(a,b);
    PRAGMA page_size;
  } 
} {1024}
db close
file delete -force test.db

# create an encrypted database, rekey it plaintext, and verify results
foreach mode {delete wal} {
  do_test rekey-encrypted-to-plaintext-$mode {
    sqlite_orig db test.db

    execsql " 
      PRAGMA key = $hexkey;
      PRAGMA journal_mode = $mode;
      CREATE TABLE t1(a,b);
      WITH RECURSIVE counter(x) AS (VALUES (1) UNION SELECT x+1 FROM counter WHERE x < 500)
        INSERT INTO t1(a,b) SELECT x, zeroblob(5000) FROM counter;
    "

    execsql {
      PRAGMA cache_size = 0;
      PRAGMA rekey = '';
    } 
    db close

    sqlite_orig db test.db
    execsql {
      SELECT count(*) FROM t1;
      PRAGMA journal_mode;
    } 
  } "500 $mode"
  db close
  file delete -force test.db
}

# create an encrypted database, rekey it plaintext
# but fail half way through. verify the result
# is still encrypted
foreach mode {delete wal} {
  do_test rekey-encrypted-to-plaintext-error-$mode {
    sqlite_orig db test.db

    set rc {}

    execsql "
      PRAGMA key = $hexkey;
      PRAGMA journal_mode = $mode;
      CREATE TABLE t1(a,b);
      WITH RECURSIVE counter(x) AS (VALUES (1) UNION SELECT x+1 FROM counter WHERE x < 500)
        INSERT INTO t1(a,b) SELECT x, zeroblob(5000) FROM counter;
    " 

    lappend rc [catchsql {
      PRAGMA cache_size = 0;
      PRAGMA cipher_test_on = fail_rekey;
      PRAGMA rekey = '';
    }]
    db close

    sqlite_orig db test.db
    lappend rc [catchsql {
      SELECT count(*) FROM t1;
    }]
    db close

    sqlite_orig db test.db
    lappend rc [execsql "
      PRAGMA key = $hexkey;
      SELECT count(*) FROM t1;
      PRAGMA cipher_test_off = fail_rekey;
    "]
   
  } {{1 {An error occurred with PRAGMA key or rekey.}} {1 {file is not a database}} {ok 500}}
  db close
  file delete -force test.db
}

# create a regular sqlite database, rekey it, and verify results
# note that this database will have a page size of 1024 which
# will exercise the rekey's page size adjustment branch
foreach mode {delete wal} {
  do_test rekey-plaintext-to-encrypted-$mode {
    sqlite_orig db test.db

    execsql " 
      PRAGMA journal_mode = $mode;
      CREATE TABLE t1(a,b);
      WITH RECURSIVE counter(x) AS (VALUES (1) UNION SELECT x+1 FROM counter WHERE x < 500)
        INSERT INTO t1(a,b) SELECT x, zeroblob(5000) FROM counter;
      PRAGMA rekey = $hexkey;
    " 
    db close

    sqlite_orig db test.db
    execsql "
      PRAGMA key = $hexkey;
      SELECT count(*) FROM t1;
      PRAGMA page_size;
      PRAGMA journal_mode;
    "
  } "ok 500 8192 $mode"
  db close
  file delete -force test.db
}

# create a regular sqlite database, rekey it, verify
# failure behavior
foreach mode {delete wal} {
  do_test rekey-plaintext-to-encrypted-error-$mode {
    sqlite_orig db test.db

    set rc {}

    execsql "
      PRAGMA journal_mode = $mode;
      CREATE TABLE t1(a,b);
      WITH RECURSIVE counter(x) AS (VALUES (1) UNION SELECT x+1 FROM counter WHERE x < 500)
        INSERT INTO t1(a,b) SELECT x, zeroblob(5000) FROM counter;
    " 
    lappend rc [catchsql "
      PRAGMA cache_size = 0;
      PRAGMA cipher_test_on = fail_rekey;
      PRAGMA rekey = $hexkey;
    "]
    db close

    sqlite_orig db test.db
    lappend rc [execsql {
      SELECT count(*) FROM t1;
      PRAGMA page_size;
      PRAGMA cipher_test_off = fail_rekey;
    }] 
  } {{1 {An error occurred with PRAGMA key or rekey.}} {500 8192}}
  db close
  file delete -force test.db
}

# create a regular sqlite database with custom page size
# using the SQLCipher default of 8192. rekey it, and verify results.
# this will bypass the page size adjustment branch
# in rekey
do_test rekey-plaintext-to-encrypted-sqlcipher-default-page-size {
  sqlite_orig db test.db

  execsql "
    PRAGMA page_size = 8192;
    CREATE TABLE t1(a,b);
    WITH RECURSIVE counter(x) AS (VALUES (1) UNION SELECT x+1 FROM counter WHERE x < 500)
      INSERT INTO t1(a,b) SELECT x, zeroblob(5000) FROM counter;
    PRAGMA rekey = $hexkey;
  "
  db close

  sqlite_orig db test.db
  execsql "
    PRAGMA key = $hexkey;
    SELECT count(*) FROM t1;
    PRAGMA page_size;
  "
} {ok 500 8192}
db close
file delete -force test.db

# test rekey encryption/decryption works with all legacy and current
# cipher compatibility levels, exercising the different combinations
# of page size, kdf iterations, algorithms, HMAC and AEAD settings
# that SQLCipher has supported over the years. Two of these test
# iterations are redundant with the prior default tests, but we're
# leaving them so we don't miss them for a future release where major
# version changes
foreach version {1 2 3 4 5} {

  # create a regular sqlite database, rekey it, and verify results
  # the new database should be created with the proper version
  # settings which persist through and are checked.
  do_test rekey-plaintext-to-encrypted-compatibility-$version {
    sqlite_orig db test.db

    execsql "
      CREATE TABLE t1(a,b);
      WITH RECURSIVE counter(x) AS (VALUES (1) UNION SELECT x+1 FROM counter WHERE x < 500)
        INSERT INTO t1(a,b) SELECT x, zeroblob(5000) FROM counter;
      PRAGMA cipher_default_compatibility = $version;
      PRAGMA cache_size = 0;
      PRAGMA rekey = 'testkey';
      PRAGMA cipher_default_compatibility = 5; -- reset default to avoid polluting future iterations
    "
    db close

    sqlite_orig db test.db
    execsql "
      PRAGMA key = 'testkey';
      PRAGMA cipher_compatibility = $version;
      SELECT count(*) FROM t1;
      PRAGMA integrity_check;
    "
  } {ok 500 ok}
  db close
  file delete -force test.db

  # create an encrypted database with the right compatibility settings
  # the rekey it to plaintext and verify results
  do_test rekey-encrypted-to-plaintext-compatibility-$version {
    sqlite_orig db test.db

    execsql "
      PRAGMA key = 'testkey';
      PRAGMA cipher_compatibility = $version;
      CREATE TABLE t1(a,b);
      WITH RECURSIVE counter(x) AS (VALUES (1) UNION SELECT x+1 FROM counter WHERE x < 500)
        INSERT INTO t1(a,b) SELECT x, zeroblob(5000) FROM counter;
      PRAGMA cache_size = 0;
      PRAGMA rekey = '';
    "
    db close

    sqlite_orig db test.db
    execsql {
      SELECT count(*) FROM t1;
      PRAGMA integrity_check;
    }
  } {500 ok}
  db close
  file delete -force test.db
}

# rekey may not be used if shared cache is enabled because
# application on one connection could not safely block others
do_test connection-shared-cache-no-rekey {
  sqlite_orig db file:test.db?cache=shared
  sqlite_orig db2 file:test.db?cache=shared
  
  set rc {}
 
  execsql {
    PRAGMA key = 'testkey';
    CREATE TABLE t1(a,b);
  }

  lappend rc [execsql {
    SELECT count(*) FROM sqlite_master;
  } db2]

  lappend rc [catchsql {
    PRAGMA rekey = 'testkey2';
  }]
} {1 {1 {An error occurred with PRAGMA key or rekey.}}}
db close
db2 close
file delete -force test.db

foreach mode {delete wal} {
  # create an encrypted database, rekey it, and verify results. The
  # zero cache size spills pages to disk before the rekey commits
  do_test rekey-encrypted-to-encrypted-$mode {
    sqlite_orig db test.db

    execsql "
      PRAGMA key = $hexkey;
      PRAGMA journal_mode = $mode;
      CREATE TABLE t1(a,b);
      WITH RECURSIVE counter(x) AS (VALUES (1) UNION SELECT x+1 FROM counter WHERE x < 10)
        INSERT INTO t1(a,b) SELECT x, zeroblob(5000) FROM counter;
      PRAGMA cache_size = 0;
      PRAGMA rekey = $hexkey2;
    "
    db close

    sqlite_orig db test.db
    execsql "
      PRAGMA key = $hexkey2;
      SELECT count(*) FROM t1;
      PRAGMA page_size;
      PRAGMA journal_mode;
    "
  } "ok 10 8192 $mode"
  db close
  file delete -force test.db

  # create an encrypted database. Open a second connection to that database
  # attempt to rekey it. Because it is encrypted-to-encrypted
  # SQLCipher will not attempt to change the journal mode during the
  # rekey, and this will work. The second connection will be left in an
  # unusable state however. A third connection opened after the rekey
  # should work properly.
  do_test rekey-encrypted-to-encrypted-multi-conn-$mode {
    set rc {}

    # first connection creates data and schema
    sqlite_orig db test.db
    execsql "
      PRAGMA key = $hexkey;
      PRAGMA journal_mode = $mode;
      CREATE TABLE t1(a,b);
      WITH RECURSIVE counter(x) AS (VALUES (1) UNION SELECT x+1 FROM counter WHERE x < 10)
        INSERT INTO t1(a,b) SELECT x, zeroblob(5000) FROM counter;
    "

    # second connection keys and reads schema
    sqlite_orig db2 test.db
    lappend rc [execsql "
      PRAGMA key = $hexkey;
      SELECT count(*) FROM sqlite_master;
    " db2]

    # first connection rekeys
    lappend rc [execsql "
      PRAGMA rekey = $hexkey2;
    "]

    # second connection has the wrong key, can't read
    lappend rc [catchsql "
      SELECT count(*) FROM t1;
    " db2]

    # third connection comes in with new key, can read
    sqlite_orig db3 test.db
    lappend rc [execsql "
      PRAGMA key = $hexkey2;
      SELECT count(*) FROM t1;
    " db3]

    db close
    db2 close
    db3 close

    # reopen and verify clean state
    sqlite_orig db test.db
    lappend rc [execsql "
      PRAGMA key = $hexkey2;
      SELECT count(*) FROM t1;
      PRAGMA page_size;
      PRAGMA journal_mode;
    "]
  } "{ok 1} ok {1 {file is not a database}} {ok 10} {ok 10 8192 $mode}"
  db close
  file delete -force test.db

  # create an encrypted database. Open a second connection to that database and then
  # attempt to rekey it. Close the rekey connection first, then close the second connection (which is in an unusable state)
  # causing it close the WAL last. When the connection closes it will attempt a checkpoint
  # which will fail. Then the reopen should detect the wal, recover and the database should be readable.
  do_test rekey-encrypted-to-encrypted-multi-conn-close-order-$mode {
    set rc {}

    # first connection creates data and schema. Write a small amount of data
    # that falls under the autocheckpoint threshold, and disable autocheckpoint
    # for safety
    sqlite_orig db test.db
    execsql "
      PRAGMA key = $hexkey;
      PRAGMA journal_mode = $mode;
      PRAGMA wal_autocheckpoint = 0;
      CREATE TABLE t1(a,b);
      WITH RECURSIVE counter(x) AS (VALUES (1) UNION SELECT x+1 FROM counter WHERE x < 10)
        INSERT INTO t1(a,b) SELECT x, zeroblob(5000) FROM counter;
    "

    # second connection keys and reads schema
    sqlite_orig db2 test.db
    lappend rc [execsql "
      PRAGMA key = $hexkey;
      SELECT count(*) FROM sqlite_master;
    " db2]

    # first connection rekeys
    lappend rc [execsql "
      PRAGMA rekey = $hexkey2;
    "]

    # ordering is important, the bad connection must close last
    db close

    # checkpoint with bad key fails
    db2 close

    # reopen and verify clean state
    sqlite_orig db test.db
    lappend rc [execsql "
      PRAGMA key = $hexkey2;
      SELECT count(*) FROM t1;
      PRAGMA page_size;
      PRAGMA journal_mode;
    "]
  } "{ok 1} ok {ok 10 8192 $mode}"
  db close
  file delete -force test.db
}

# create an encrypted WAL database and hold a read transaction open on another connection. This will block
# the rekey from checkpointing the WAL and the rekey will fail.
do_test rekey-encrypted-to-encrypted-wal-busy {
  set rc {}

  sqlite_orig db test.db
  execsql "
    PRAGMA key = $hexkey;
    PRAGMA journal_mode = wal;
    CREATE TABLE t1(a,b);
    INSERT INTO t1(a,b) VALUES (1,2);
  "

  sqlite_orig db2 test.db
  execsql "
    PRAGMA key = $hexkey;
    BEGIN;
    SELECT count(*) FROM t1;
  " db2

  lappend rc [catchsql "
    PRAGMA rekey = $hexkey2;
  "]

  execsql {
    COMMIT;
  } db2
  db2 close
  db close

  sqlite_orig db test.db
  lappend rc [execsql "
    PRAGMA key = $hexkey;
    SELECT count(*) FROM t1;
  "]
} {{1 {An error occurred with PRAGMA key or rekey.}} {ok 1}}
db close
file delete -force test.db

# create an encrypted WAL database and write more frames than there are pages in the
# main database. Rekey will start off with a truncate, and then write only
# one frame per database page, so the count at the end should be equal
# to page count.
do_test rekey-encrypted-to-encrypted-wal-truncate {
  set rc {}

  sqlite_orig db test.db
  execsql "
    PRAGMA key = $hexkey;
    PRAGMA journal_mode = wal;
    PRAGMA wal_autocheckpoint = 0;
    CREATE TABLE t1(a,b);
    INSERT INTO t1(a,b) VALUES (1,2);
    UPDATE t1 SET b = 3;
    UPDATE t1 SET b = 4;
    UPDATE t1 SET b = 5;
    PRAGMA rekey = $hexkey2;
  "

  lappend rc [execsql {
    PRAGMA page_count;
  }]

  # 32 byte WAL header, 24 byte frame headers
  lappend rc [expr {([file size test.db-wal] - 32) / (8192 + 24)}]
} {2 2}
db close
file delete -force test.db

# a second connection holds a write transaction open. register a busy
# handler so we can slide in a commit after the rekey started. That
# should be permitted in DELETE but fail in WAL. 
foreach {mode result} {
  delete {0 ok}
  wal {1 {An error occurred with PRAGMA key or rekey.}}
} {
  do_test rekey-encrypted-to-encrypted-data-version-$mode {
    set rc {}

    sqlite_orig db test.db
    execsql "
      PRAGMA key = $hexkey;
      PRAGMA journal_mode = $mode;
      CREATE TABLE t1(a,b);
      INSERT INTO t1(a,b) VALUES (1,2);
    "

    sqlite_orig db2 test.db
    execsql "
      PRAGMA key = $hexkey;
      BEGIN IMMEDIATE;
      INSERT INTO t1(a,b) VALUES (3,4);
    " db2

    # Use Tcl hack to turn the retry count appended by the handler into a comment
    # this will commit the transaction on db2 while db is waiting effectively
    # interleaving the commit in between when rekey gets the pager data version first
    # and the later check before starting the rekey.
    db busy {db2 eval COMMIT ;#}
    lappend rc [catchsql "
      PRAGMA rekey = $hexkey2;
    "]

    lappend rc [execsql {
      SELECT count(*) FROM t1;
    }]
  } [list $result 2]
  db close
  db2 close
  file delete -force test.db
}

# rekey can't run inside a transaction
do_test rekey-fail-in-transaction {
  set rc {}

  sqlite_orig db test.db
  execsql "
    PRAGMA key = $hexkey;
    CREATE TABLE t1(a,b);
    INSERT INTO t1(a,b) VALUES (1,2);
  "

  lappend rc [catchsql "
    BEGIN;
    INSERT INTO t1(a,b) VALUES (3,4);
    PRAGMA rekey = $hexkey2;
  "]

  lappend rc [execsql {
    ROLLBACK;
    SELECT count(*) FROM t1;
  }]
} {{1 {An error occurred with PRAGMA key or rekey.}} 1}
db close
file delete -force test.db

do_test rekey-inside-savepoint {
  sqlite_orig db test.db

  execsql {
    PRAGMA key = 'test123';
    CREATE TABLE t1(a,b);
    INSERT INTO t1 VALUES(1,2);
    SAVEPOINT s1;
    INSERT INTO t1 VALUES(2,3);
  }

  set rc {}
  lappend rc [catchsql { PRAGMA rekey = 'test456'; }]
  lappend rc [sqlite3_get_autocommit db]
  lappend rc [execsql { SELECT count(*) FROM t1; }]
  execsql { ROLLBACK TO s1; RELEASE s1; }
  lappend rc [execsql { SELECT count(*) FROM t1; }]

  set rc
} {{1 {An error occurred with PRAGMA key or rekey.}} 0 2 1}
db close
file delete -force test.db

# and for an attached schema, since autocommit is per connection
do_test rekey-inside-transaction-attached {
  sqlite_orig db test.db

  execsql {
    PRAGMA key = 'test123';
    ATTACH DATABASE 'aux.db' AS aux;
    PRAGMA aux.key = 'auxkey';
    CREATE TABLE aux.t2(a);
    INSERT INTO aux.t2 VALUES(1);
    BEGIN;
    INSERT INTO aux.t2 VALUES(2);
  }

  set rc {}
  lappend rc [catchsql { PRAGMA aux.rekey = 'auxkey2'; }]
  lappend rc [sqlite3_get_autocommit db]
  lappend rc [execsql { SELECT count(*) FROM aux.t2; }]
  execsql { ROLLBACK; }
  lappend rc [execsql { SELECT count(*) FROM aux.t2; }]

  set rc
} {{1 {An error occurred with PRAGMA key or rekey.}} 0 2 1}
db close
file delete -force test.db
file delete -force aux.db

# rekey from a function of a running INSERT fails and keeps the INSERT atomic
do_test rekey-inside-statement {
  sqlite_orig db test.db

  execsql {
    PRAGMA key = 'test123';
    CREATE TABLE t1(a);
    INSERT INTO t1 VALUES(1),(2),(2);
    CREATE TABLE t2(a UNIQUE);
  }

  set ::rekey_calls 0
  set ::rekey_rc {}
  proc rekey_once {a} {
    if {[incr ::rekey_calls]==2} {
      set ::rekey_rc [catchsql { PRAGMA rekey = 'test456'; }]
    }
    return $a
  }
  db function rekey_once rekey_once

  set rc {}
  lappend rc [catchsql { INSERT INTO t2 SELECT rekey_once(a) FROM t1 ORDER BY rowid; }]
  lappend rc $::rekey_rc
  lappend rc [sqlite3_get_autocommit db]
  lappend rc [execsql { SELECT count(*) FROM t2; }]
  db close

  sqlite_orig db test.db
  lappend rc [execsql { PRAGMA key = 'test123'; SELECT count(*) FROM t2; }]

  set rc
} {{1 {UNIQUE constraint failed: t2.a}} {1 {An error occurred with PRAGMA key or rekey.}} 1 0 {ok 0}}
db close
file delete -force test.db

# rekey while a SELECT is stepping fails and the reader completes
do_test rekey-with-active-reader {
  sqlite_orig db test.db

  execsql {
    PRAGMA key = 'test123';
    CREATE TABLE t1(a);
    INSERT INTO t1 VALUES(1),(2),(3);
  }

  set rc {}
  set rows 0
  db eval { SELECT a FROM t1 } {
    if {[incr rows]==1} {
      lappend rc [catchsql { PRAGMA rekey = 'test456'; }]
    }
  }
  lappend rc $rows
  db close

  sqlite_orig db test.db
  lappend rc [execsql { PRAGMA key = 'test123'; SELECT count(*) FROM t1; }]

  set rc
} {{1 {An error occurred with PRAGMA key or rekey.}} 3 {ok 3}}
db close
file delete -force test.db

# rekey encrypted database without keying
do_test rekey-encrypted-without-keying {
  sqlite_orig db test.db
  execsql "
    PRAGMA key = $hexkey;
    CREATE TABLE t1(a,b);
    INSERT INTO t1(a,b) VALUES (1,2);
  "
  db close

  sqlite_orig db test.db
  catchsql "
    PRAGMA rekey = $hexkey2;
  "
} {1 {An error occurred with PRAGMA key or rekey.}}
db close
file delete -force test.db

finish_test
