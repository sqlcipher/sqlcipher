# that calling pragma key will return an misuse error
do_test non-sqlcipher-vfs {
  sqlite_orig db file:test.db?vfs=unix

  catchsql "
    PRAGMA key = $hexkey;
  "

} {1 {An error occurred with PRAGMA key or rekey.}}
