# verify data is readable even if mmap is enabled
# because the vfs disables it to prevent direct reads
do_test will-open-with-mmap {
  sqlite_orig db test.db
  execsql "
    PRAGMA key = $hexkey;
    CREATE TABLE t1(a,b);
    WITH RECURSIVE counter(x) AS (VALUES (1) UNION SELECT x+1 FROM counter WHERE x < 1000)
      INSERT INTO t1(a,b) SELECT x, random() % 50000 FROM counter;
  "
  db close

  sqlite_orig db test.db
  execsql "
    PRAGMA mmap_size = 67108864;
    PRAGMA key = $hexkey;
    SELECT count(*) from t1;
  "
} {67108864 ok 1000}
db close
file delete -force test.db

# cache spill / corruption tests
foreach mode {delete wal truncate persist} {
  
  # write content to the database inside a transaction, then update it in place. This will
  # rewrite pages / frames. In Wal mode this will cause checksume rewrite as well
  do_test inplace-overwrite-$mode {
    sqlite_orig db test.db
    set rc {}
    sqlite3_db_status db SQLITE_DBSTATUS_CACHE_SPILL 1

    execsql "
      PRAGMA key = $hexkey;
      PRAGMA cache_size = 0;
      PRAGMA journal_mode = $mode;
      CREATE TABLE t1(a, b);
      BEGIN;
      WITH RECURSIVE counter(x) AS (VALUES (1) UNION SELECT x+1 FROM counter WHERE x < 500)
        INSERT INTO t1(a,b) SELECT x, zeroblob(5000) FROM counter;
    "

    # verify at least 50% of the pages spilled to cache. In practice cache_size = 0 so everything
    # shoudl spill, but this is dependent on the combination of row size, blob size, default
    # page size, etc, so we make it explicit for this test.
    lappend rc [expr {[lindex [sqlite3_db_status db SQLITE_DBSTATUS_CACHE_SPILL 1] 1] > 250}]

    execsql "UPDATE t1 SET b=zeroblob(4999) WHERE a<250"

    lappend rc [expr {[lindex [sqlite3_db_status db SQLITE_DBSTATUS_CACHE_SPILL 1] 1] > 175}]

    execsql { 
      COMMIT;
      PRAGMA wal_checkpoint(FULL);
    }

    lappend rc [execsql {
      SELECT count(*) FROM t1;
    }]
  } {1 1 500}
  db close

  # run integrity check
  do_test inplace-overwrite-reopen-$mode {
    sqlite_orig db test.db

    execsql "
      PRAGMA key = $hexkey;
      PRAGMA integrity_check;
    "
  } {ok ok}
  db close
  file delete -force test.db

  # similar test to above, but execute a rollback instead of a commit
  do_test rollback-after-spill-$mode {
    sqlite_orig db test.db
    set rc {}
    sqlite3_db_status db SQLITE_DBSTATUS_CACHE_SPILL 1

    execsql "
      PRAGMA key = $hexkey;
      PRAGMA journal_mode = $mode;
      PRAGMA cache_size = 0;
      CREATE TABLE t1(a, b);
      BEGIN;
      WITH RECURSIVE counter(x) AS (VALUES (1) UNION SELECT x+1 FROM counter WHERE x < 500)
        INSERT INTO t1(a,b) SELECT x, zeroblob(5000) FROM counter;
      COMMIT;
    "

    # new transaction writes and spills, but then rolls back
    execsql {
      BEGIN;
      WITH RECURSIVE counter(x) AS (VALUES (1) UNION SELECT x+1 FROM counter WHERE x < 2000)
        INSERT INTO t1(a,b) SELECT x, zeroblob(5000) FROM counter;
    }

    lappend rc [expr {[lindex [sqlite3_db_status db SQLITE_DBSTATUS_CACHE_SPILL 1] 1] > 1000}]

    execsql "UPDATE t1 SET b=zeroblob(4999) WHERE a<250"

    lappend rc [expr {[lindex [sqlite3_db_status db SQLITE_DBSTATUS_CACHE_SPILL 1] 1] > 175}]

    execsql {
      ROLLBACK;
    }

    lappend rc [execsql {
      SELECT count(*) FROM t1;
    }]
  } {1 1 500}
  db close

  do_test rollback-after-spill-reopen-$mode {
    sqlite_orig db test.db
    execsql "
      PRAGMA key = $hexkey;
      PRAGMA integrity_check;
    "
  } {ok ok}
  db close
  file delete -force test.db
}



# Test the scenario where the page size is set to the exact same value
# as the sector size. In this case writes of a journal file to the the journal can't be destinguished 
# from encrypted pages by page size alone, and instead must be gated based on the position in the journal file. 
# With PSOW enabled the default sector size would be set to 512 which is  too small to support SQLCipher's
# reserve size requirement (reserve on a 512 db is limited to 32 bytes). As a result, psow is disable for
# these tests. Then page size is set to 4096 to match the sector size. Then we write a bunch of data out to the journal
# file, and make sure that journal headers are written. Then we process a commit, and do
# the same with a rollback to ensure that they both work and the page accounting works.

foreach mode {delete truncate persist} {

  # write content to the database inside a transaction and ensure that
  # cache spills to journal file and headers are written
  do_test journal-header-prepare-$mode {
    sqlite_orig db file:test.db?psow=0

    set rc {}
    sqlite3_db_status db SQLITE_DBSTATUS_CACHE_SPILL 1

    execsql "
      PRAGMA key = $hexkey;
      PRAGMA cipher_page_size = 4096;
      PRAGMA journal_mode = $mode;
      PRAGMA cache_size = 0;
      CREATE TABLE t1(a, b);
      WITH RECURSIVE counter(x) AS (VALUES (1) UNION SELECT x+1 FROM counter WHERE x < 500)
        INSERT INTO t1(a,b) SELECT x, zeroblob(4000) FROM counter;
      BEGIN;
      UPDATE t1 SET b = zeroblob(4001);
    "

    set jfs [file size test.db-journal] 
    set pages [expr {[file size test.db] / 4096}]
    set spills [lindex [sqlite3_db_status db SQLITE_DBSTATUS_CACHE_SPILL 1] 1]

    # there should at least two headers in the file
    lappend rc [expr {(($jfs - (4096*500)) / 4096) > 2 }]
    # more spills than pages (due to rewrites)
    lappend rc [expr { $spills > $pages }]

    execsql { 
      COMMIT;
      PRAGMA wal_checkpoint(FULL);
    }

    lappend rc [execsql {
      SELECT count(*) FROM t1;
      SELECT count(*) FROM t1 WHERE a > 500
    }]
  } {1 1 {500 0}}
  db close

  # open previous file, insert less data but still spill, then rollback
  # in persist mode specifically, this would allow reuse of the
  # existing journal file from the previous step, so ensure that the
  # rollback succeeds and the integrity check passes
  do_test journal-header-rollback-$mode {
    sqlite_orig db file:test.db?psow=0

    set rc {}
    sqlite3_db_status db SQLITE_DBSTATUS_CACHE_SPILL 1

    if { $mode == "persist" } {
      # verify that the journal is still on disk and reused
      lappend rc [expr { [file size test.db-journal] > 4096*500 }]
    } else {
      lappend rc 1
    }

    execsql "
      PRAGMA key = $hexkey;
      PRAGMA cipher_page_size = 4096;
      PRAGMA journal_mode = $mode;
      PRAGMA cache_size = 0;
      BEGIN;
      WITH RECURSIVE counter(x) AS (VALUES (501) UNION SELECT x+1 FROM counter WHERE x < 700)
        INSERT INTO t1(a,b) SELECT x, zeroblob(4000) FROM counter;
      UPDATE t1 SET b = zeroblob(4002);
    "

    set spills [lindex [sqlite3_db_status db SQLITE_DBSTATUS_CACHE_SPILL 1] 1]
    # more spills than pages (due to rewrites)
    lappend rc [expr { $spills > 200 }]

    execsql {
      ROLLBACK;
    }

    lappend rc [execsql {
      SELECT count(*) FROM t1;
      SELECT count(*) FROM t1 WHERE a > 500;
      PRAGMA integrity_check;
    }]
  } {1 1 {500 0 ok}}
  db close

  file delete -force test.db
}

# Run a looped series of tests covering the major journal modes,
# various page sizes, and PSOW options to verify that
# recovery works. This provides a broad exercise of the
# recovery system. It covers some very important cases
# when PSOW=0 and page_sz = 4096 where page size is equal to 
# sector size, which affects journal header detection and
# the logic to split wal writes across sector boundaries.
#
# Each of these tests has a common flow, where the start
# sets up a new database and populates rows into to. Then
# a force copy of the database is ues to simulate a crash (similar to
# sqlite WAL tests). In WAL mode -shm is not included. When those
# copies are opened recover runs and the state is verified.
#
# Some special pragmas are important here:
# - cache_size = 0 forces page spill to pages are not cached
# - wal_autocheckpoint prevents non-deterministic checkpointing
# - synchronous set to FULL when psow is 0 to force split writes

foreach mode {delete persist wal} {
  foreach page_sz {1024 4096 8192} {
    foreach {psow sync} {0 FULL 1 NORMAL} {

      set rows 50
      # PSOW=0 tests cover split writes and will use 10x volume
      if { $psow == 0 } {
        set rows 500
      } 

      # verify that commits can be successfully rolled back
      # on an open transaction
      do_test rollback-$mode-$page_sz-$psow {
        sqlite_orig db file:test.db?psow=$psow
        execsql "
          PRAGMA key = $hexkey;
          PRAGMA cipher_page_size = $page_sz;
          PRAGMA journal_mode = $mode;
          PRAGMA synchronous = $sync;
          PRAGMA wal_autocheckpoint = 0;
          PRAGMA cache_size = 0;
          CREATE TABLE t1(a INTEGER PRIMARY KEY, b);
          INSERT INTO t1 VALUES(1, zeroblob(500));
          BEGIN;
        "
        for {set i 2} {$i <= $rows} {incr i} {
          execsql "INSERT INTO t1 VALUES($i, zeroblob(2000))"
        }
        execsql {
          ROLLBACK;
          SELECT count(*) FROM t1;
          PRAGMA integrity_check;
        }
      } {1 ok}
      db close
      forcedelete test.db test.db-journal test.db-wal test.db-shm

      # make many small commits to stress split write wal frames
      # splits that will occur when PSOW=0 and synchronous=FULL.
      # A split write occurs whenver a frame write will straddle a sector 
      # boundary. In practice, this will happen every ~4 pages with a 1024
      # page size, and for almost every page with 4096 or 8192.
      do_test split-writes-$mode-$page_sz-$psow {
        sqlite_orig db file:test.db?psow=$psow
        execsql "
          PRAGMA key = $hexkey;
          PRAGMA cipher_page_size = $page_sz;
          PRAGMA journal_mode = $mode;
          PRAGMA synchronous = $sync;
          PRAGMA wal_autocheckpoint = 0;
          PRAGMA cache_size = 0;
          CREATE TABLE t1(a INTEGER PRIMARY KEY, b);
          INSERT INTO t1 VALUES(1, zeroblob(64));
        "
        for {set i 2} {$i <= $rows} {incr i} {
          execsql "INSERT INTO t1 VALUES($i, zeroblob(64))"
        }

        forcecopy test.db test2.db

        if {[file exists test.db-wal]} {
          forcecopy test.db-wal test2.db-wal
        }
        if {[file exists test.db-journal]} {
          forcecopy test.db-journal test2.db-journal
        }
        db close

        sqlite_orig db file:test2.db?psow=$psow
        execsql "
          PRAGMA key = $hexkey;
          PRAGMA cipher_page_size = $page_sz;
          PRAGMA integrity_check;
          SELECT count(*) FROM t1;
        "
      } "ok ok $rows"
      db close
      forcedelete test.db test.db-journal test.db-wal test.db-shm
      forcedelete test2.db test2.db-journal test2.db-wal test2.db-shm

      # if a transaction is committed in wal mode but not checkpointed
      # data will still be in the wal file. verify that it is
      # consistent post recovery
      do_test recover-committed-$mode-$page_sz-$psow {
        sqlite_orig db file:test.db?psow=$psow
        execsql "
          PRAGMA key = $hexkey;
          PRAGMA cipher_page_size = $page_sz;
          PRAGMA journal_mode = $mode;
          PRAGMA synchronous = $sync;
          PRAGMA wal_autocheckpoint = 0;
          PRAGMA cache_size = 0;
          CREATE TABLE t1(a INTEGER PRIMARY KEY, b);
          INSERT INTO t1 VALUES(1, zeroblob(500));
          BEGIN;
        "
        for {set i 2} {$i <= $rows} {incr i} {
          execsql "INSERT INTO t1 VALUES($i, zeroblob(2000))"
        }

        execsql { COMMIT; }

        forcecopy test.db test2.db

        if {[file exists test.db-wal]} {
          forcecopy test.db-wal test2.db-wal
        }
        if {[file exists test.db-journal]} {
          forcecopy test.db-journal test2.db-journal
        }
        db close

        sqlite_orig db file:test2.db?psow=$psow
        execsql "
          PRAGMA key = $hexkey;
          PRAGMA cipher_page_size = $page_sz;
          PRAGMA integrity_check;
          SELECT count(*) FROM t1;
        "
      } "ok ok $rows"
      db close
      forcedelete test.db test.db-journal test.db-wal test.db-shm
      forcedelete test2.db test2.db-journal test2.db-wal test2.db-shm

      # if a transaction is not committed, verify it is rolled
      # back as part of the recovery process
      do_test recover-uncommitted-$mode-$page_sz-$psow {
        sqlite_orig db file:test.db?psow=$psow
        execsql "
          PRAGMA key = $hexkey;
          PRAGMA cipher_page_size = $page_sz;
          PRAGMA journal_mode = $mode;
          PRAGMA synchronous = $sync;
          PRAGMA wal_autocheckpoint = 0;
          PRAGMA cache_size = 0;
          CREATE TABLE t1(a INTEGER PRIMARY KEY, b);
          INSERT INTO t1 VALUES(1, zeroblob(500));
          BEGIN;
        "
        for {set i 2} {$i <= $rows} {incr i} {
          execsql "INSERT INTO t1 VALUES($i, zeroblob(2000))"
        }

        # do not commit transaction

        forcecopy test.db test2.db

        if {[file exists test.db-wal]} {
          forcecopy test.db-wal test2.db-wal
        }
        if {[file exists test.db-journal]} {
          forcecopy test.db-journal test2.db-journal
        }
        db close

        sqlite_orig db file:test2.db?psow=$psow
        execsql "
          PRAGMA key = $hexkey;
          PRAGMA cipher_page_size = $page_sz;
          PRAGMA integrity_check;
          SELECT count(*) FROM t1;
        "
      } {ok ok 1}
      db close
      forcedelete test.db test.db-journal test.db-wal test.db-shm
      forcedelete test2.db test2.db-journal test2.db-wal test2.db-shm

      # Use of an incorrect key should fail recovery
      do_test recover-bad-key-$mode-$page_sz-$psow {
        sqlite_orig db file:test.db?psow=$psow
        execsql "
          PRAGMA key = $hexkey;
          PRAGMA cipher_page_size = $page_sz;
          PRAGMA journal_mode = $mode;
          PRAGMA synchronous = $sync;
          PRAGMA wal_autocheckpoint = 0;
          PRAGMA cache_size = 0;
          CREATE TABLE t1(a INTEGER PRIMARY KEY, b);
          INSERT INTO t1 VALUES(1, zeroblob(500));
          PRAGMA wal_checkpoint = FULL;
          BEGIN;
        "
        for {set i 2} {$i <= $rows} {incr i} {
          execsql "INSERT INTO t1 VALUES($i, zeroblob(2000))"
        }

        execsql { COMMIT; }

        forcecopy test.db test2.db

        if {[file exists test.db-wal]} {
          forcecopy test.db-wal test2.db-wal
        }
        if {[file exists test.db-journal]} {
          forcecopy test.db-journal test2.db-journal
        }
        db close

        # unable to open file get error
        sqlite_orig db file:test2.db?psow=$psow
        set err [lindex [catchsql "
          PRAGMA key = 'test';
          PRAGMA cipher_page_size = $page_sz;
          SELECT count(*) FROM t1;
        "] 0]

        set success [execsql "
          PRAGMA key = $hexkey;
          PRAGMA cipher_page_size = $page_sz;
          SELECT count(*) FROM t1;
        "]

        list $err $success
      } "1 {ok $rows}"
      db close
      forcedelete test.db test.db-journal test.db-wal test.db-shm
      forcedelete test2.db test2.db-journal test2.db-wal test2.db-shm

      # Pages in the journal can be reused. Execute two update statements in one transaction
      # that will update the same pages. This should cause the frames to be rewritten.
      do_test recover-reuse-$mode-$page_sz-$psow {
        sqlite_orig db file:test.db?psow=$psow
        execsql "
          PRAGMA key = $hexkey;
          PRAGMA cipher_page_size = $page_sz;
          PRAGMA journal_mode = $mode;
          PRAGMA synchronous = $sync;
          PRAGMA wal_autocheckpoint = 0;
          PRAGMA cache_size = 0;
          CREATE TABLE t1(a INTEGER PRIMARY KEY, b);
          INSERT INTO t1 VALUES(1, zeroblob(500));
          BEGIN;
        "
        for {set i 2} {$i <= $rows} {incr i} {
          execsql "INSERT INTO t1 VALUES($i, zeroblob(2000))"
        }

        execsql { COMMIT; }
        execsql {
          BEGIN;
          UPDATE t1 SET b = randomblob(2001);
          UPDATE t1 SET b = randomblob(2002);
          COMMIT;
        }

        forcecopy test.db test2.db

        if {[file exists test.db-wal]} {
          forcecopy test.db-wal test2.db-wal
        }
        if {[file exists test.db-journal]} {
          forcecopy test.db-journal test2.db-journal
        }
        db close

        sqlite_orig db file:test2.db?psow=$psow
        execsql "
          PRAGMA key = $hexkey;
          PRAGMA cipher_page_size = $page_sz;
          PRAGMA integrity_check;
          SELECT count(*), min(length(b)) FROM t1;
        "

      } "ok ok $rows 2002"
      db close
      forcedelete test.db test.db-journal test.db-wal test.db-shm
      forcedelete test2.db test2.db-journal test2.db-wal test2.db-shm

    }
  }
}

foreach mode {delete persist wal} {
  # open up a shared cache connection to a database, key it
  # and create a schema. Then, open a second shared cache
  # handle to the same databse. Close the first, and then
  # try to query the second. Verify that all persistent
  # pointers on the SQLCipher context are still valid
  # for use after the original is closed.
  do_test connection-shared-cache-$mode {
    sqlite_orig db file:test.db?cache=shared
    set rc {}

    execsql "
      PRAGMA key = $hexkey;
      PRAGMA journal_mode = $mode;
      CREATE TABLE t1(a,b);
      INSERT INTO t1 VALUES(1,2);
    "

    sqlite_orig db2 file:test.db?cache=shared

    lappend rc [ execsql "
      PRAGMA key = $hexkey;
      SELECT count(*) FROM t1;
    " db2 ]

    db close

    lappend rc [ execsql {
      PRAGMA cache_size = 0;
      INSERT INTO t1 VALUES(1,2);
      SELECT count(*) FROM t1;
    } db2 ]

    db2 close

    set rc
  } {{ok 1} 2}
  file delete -force test.db

  # open a shared connection from the same process. the original
  # connectiona already keyed, so the second connection
  # will skip keying. verify that works, and that nothing is allocated
  # additionally for the second connection (i.e. that the same
  # shared context is used
  do_test connection-shared-cache-no-second-key-$mode {
    sqlite_orig db file:test.db?cache=shared
    set rc {}

    execsql "
      PRAGMA key = $hexkey;
      PRAGMA journal_mode = $mode;
      CREATE TABLE t1(a,b);
      INSERT INTO t1 VALUES(1,2);
    "

    sqlite_orig db2 file:test.db?cache=shared

    set start_heap [execsql {PRAGMA cipher_test_private_heap_used;}]
    lappend rc [ execsql {
      PRAGMA key = 'x';
      INSERT INTO t1 VALUES(1,2);
      SELECT count(*) FROM t1;
    } db2 ]
    set stop_heap [execsql {PRAGMA cipher_test_private_heap_used;}]

    lappend rc [expr { $stop_heap - $start_heap }]

    db close
    db2 close

    set rc 
  } {{ok 2} 0}
  file delete -force test.db

}


finish_test
