file delete -force test.db

# test that an initialization failure which can't attach
# the context will leave the database unusuable (at least
# for writes) to prevent an unencrypted database from being
# created
do_test init-failure-blocks-db-use {
  sqlite_orig db test.db
  set rc {}

  lappend rc [catchsql "
    PRAGMA cipher_default_page_size = 123;
    PRAGMA key = $hexkey;
  "]

  lappend rc [catchsql {
    CREATE TABLE t1(a,b);
  }]

  lappend rc [catchsql {
    SELECT * FROM sqlite_master;
  }]

  db close

  sqlite_orig db :memory:
  execsql {
    PRAGMA cipher_default_page_size = 8192;
  }

  set rc
} {{1 {An error occurred with PRAGMA key or rekey.}} {1 {attempt to write a readonly database}} {1 {disk I/O error}}}
db close
file delete -force test.db

foreach mode {delete wal} {
  do_test init-failure-blocks-db-use-txn-$mode {
    sqlite_orig db test.db
    set rc {}

    lappend rc [catchsql "
      PRAGMA cipher_default_page_size = 123;
      BEGIN IMMEDIATE;
      PRAGMA key = $hexkey;
    "]

    lappend rc [catchsql {
      CREATE TABLE t1(a,b);
      COMMIT;
    }]

    lappend rc [catchsql {
      SELECT * FROM sqlite_master;
    }]

    db close

    sqlite_orig db :memory:
    execsql {
      PRAGMA cipher_default_page_size = 8192;
    }
    set rc
  } {{1 {An error occurred with PRAGMA key or rekey.}} {1 {disk I/O error}} {1 {disk I/O error}}}
  db close
  file delete -force test.db
}

# test that an error condition that occurs later in the
# lifecycle (after the context has been initialized,
# attached and loaded) will render the handle unable
# for writes
do_test post-init-failure-blocks-db-use-autocommit {
  sqlite_orig db test.db
  set rc {}

  execsql "
    PRAGMA key = $hexkey;
    CREATE TABLE t1(a,b);
    INSERT INTO t1(a,b) VALUES (1,2);
  "

  lappend rc [catchsql {
    PRAGMA cipher_hmac_algorithm = 'DNE';
  }]

  lappend rc [catchsql {
    CREATE TABLE t2(a,b);
  }]

  lappend rc [execsql {
    SELECT count(*) FROM t1;
  }]

  set rc
} {{0 {}} {1 {attempt to write a readonly database}} 1}
db close
file delete -force test.db

# test that an error condition that occurs later in the
# lifecycle (after the context has been initialized,
# attached and loaded) but inside a transacton
# will render the handle unable
# for writes and that reopening the database will
# restore previous state correctly. This will be doe
# by starting up a transaction inserting abunch of
# data spilled to disk, then triggering an error and
# attempting commit. This should trigger the codec's
# deferred error logic. Verify that reopening
# restors the database to the consistant state
foreach mode {delete wal} {

  do_test post-init-failure-blocks-db-use-txn-$mode {
    sqlite_orig db test.db
    set rc {}

    execsql "
      PRAGMA key = $hexkey;
      PRAGMA journal_mode = $mode;
      PRAGMA cache_size = 0;
      CREATE TABLE t1(a,b);
      INSERT INTO t1(a,b) VALUES (1,2);
      BEGIN IMMEDIATE;
      WITH RECURSIVE counter(x) AS (VALUES (1) UNION SELECT x+1 FROM counter WHERE x < 20)
        INSERT INTO t1(a,b) SELECT x, zeroblob(4000) FROM counter;
    "

    lappend rc [catchsql {
      PRAGMA cipher_hmac_algorithm = 'DNE';
    }]

    lappend rc [catchsql {
      CREATE TABLE t2(a,b);
    }]

    lappend rc [catchsql {
      COMMIT;
    }]

    db close
    sqlite_orig db test.db

    lappend rc [ execsql "
      PRAGMA key = $hexkey;
      SELECT count(*) FROM t1;
      PRAGMA integrity_check;
    "]

    set rc
  } "{0 {}} {1 {disk I/O error}} {1 {cannot commit - no transaction is active}} {ok 1 ok}"
  db close
  file delete -force test.db
}


# test that a failure to initialize the context does not
# leak private heap memory
do_test init-failure-no-mem-leak {
  sqlite_orig db test.db
  set rc {}

  set start_heap [execsql {PRAGMA cipher_test_private_heap_used;}]
  lappend rc [catchsql "
    PRAGMA cipher_default_page_size = 123;
    PRAGMA key = $hexkey;
  "]
  set stop_heap [execsql {PRAGMA cipher_test_private_heap_used;}]

  db close

  sqlite_orig db :memory:
  execsql {
    PRAGMA cipher_default_page_size = 8192;
  }

  lappend rc [expr { $stop_heap - $start_heap }]
} {{1 {An error occurred with PRAGMA key or rekey.}} 0}
db close
file delete -force test.db

