#
# This file implements regression tests for SQLite library.  The
# focus of this script is testing code cipher features.
#
# NOTE: tester.tcl has overridden the definition of sqlite3 to
# automatically pass in a key value. Thus tests in this file
# should explicitly close and open db with sqlite_orig in order
# to bypass default key assignment.

set testdir [file dirname $argv0]
source $testdir/tester.tcl
source $testdir/sqlcipher.tcl

# reuses shared functions from upstream SQLite wal tests
# so this is required
source $testdir/wal_common.tcl

# 8k default page size for calculations, 24 byte frame header
set pgsz 8192
set frsz [expr {$pgsz + 24}]

# Run a looped series of tests covering the major journal modes,
# various page sizes, and PSOW options to verify that
# recovery works. This provides a broad exercise of the
# recovery system. It covers some very important cases
# when PSOW=0 and page_sz = 4096 where page size is equal to 
# sector size, which affects journal header detection and
# the logic to split wal writes across sector boundaries.
#
# Each of these tests has a common flow, where the start
# sets up a new database and populates rows into to. Then
# a force copy of the database is ues to simulate a crash (similar to
# sqlite WAL tests). In WAL mode -shm is not included. When those
# copies are opened recover runs and the state is verified.
#
# Some special pragmas are important here:
# - cache_size = 0 forces page spill to pages are not cached
# - wal_autocheckpoint prevents non-deterministic checkpointing
# - synchronous set to FULL when psow is 0 to force split writes

foreach mode {delete persist wal truncate} {
  foreach page_sz {1024 4096 8192} {
    foreach {psow sync} {0 FULL 1 NORMAL} {

      set rows 50
      # PSOW=0 tests cover split writes and will use 10x volume
      if { $psow == 0 } {
        set rows 500
      } 

      # verify that commits can be successfully rolled back
      # on an open transaction
      do_test rollback-$mode-$page_sz-$psow {
        sqlite_orig db file:test.db?psow=$psow
        execsql "
          PRAGMA key = $hexkey;
          PRAGMA cipher_page_size = $page_sz;
          PRAGMA journal_mode = $mode;
          PRAGMA synchronous = $sync;
          PRAGMA wal_autocheckpoint = 0;
          PRAGMA cache_size = 0;
          CREATE TABLE t1(a INTEGER PRIMARY KEY, b);
          INSERT INTO t1 VALUES(1, zeroblob(500));
          BEGIN;
        "
        for {set i 2} {$i <= $rows} {incr i} {
          execsql "INSERT INTO t1 VALUES($i, zeroblob(2000))"
        }
        execsql {
          ROLLBACK;
          SELECT count(*) FROM t1;
          PRAGMA integrity_check;
        }
      } {1 ok}
      db close
      forcedelete test.db test.db-journal test.db-wal test.db-shm

      # make many small commits to stress split write wal frames
      # splits that will occur when PSOW=0 and synchronous=FULL.
      # A split write occurs whenver a frame write will straddle a sector 
      # boundary. In practice, this will happen every ~4 pages with a 1024
      # page size, and for almost every page with 4096 or 8192.
      do_test split-writes-$mode-$page_sz-$psow {
        sqlite_orig db file:test.db?psow=$psow
        execsql "
          PRAGMA key = $hexkey;
          PRAGMA cipher_page_size = $page_sz;
          PRAGMA journal_mode = $mode;
          PRAGMA synchronous = $sync;
          PRAGMA wal_autocheckpoint = 0;
          PRAGMA cache_size = 0;
          CREATE TABLE t1(a INTEGER PRIMARY KEY, b);
          INSERT INTO t1 VALUES(1, zeroblob(64));
        "
        for {set i 2} {$i <= $rows} {incr i} {
          execsql "INSERT INTO t1 VALUES($i, zeroblob(64))"
        }

        forcecopy test.db test2.db

        if {[file exists test.db-wal]} {
          forcecopy test.db-wal test2.db-wal
        }
        if {[file exists test.db-journal]} {
          forcecopy test.db-journal test2.db-journal
        }
        db close

        sqlite_orig db file:test2.db?psow=$psow
        execsql "
          PRAGMA key = $hexkey;
          PRAGMA cipher_page_size = $page_sz;
          PRAGMA integrity_check;
          SELECT count(*) FROM t1;
        "
      } "ok ok $rows"
      db close
      forcedelete test.db test.db-journal test.db-wal test.db-shm
      forcedelete test2.db test2.db-journal test2.db-wal test2.db-shm

      # if a transaction is committed in wal mode but not checkpointed
      # data will still be in the wal file. verify that it is
      # consistent post recovery
      do_test recover-committed-$mode-$page_sz-$psow {
        sqlite_orig db file:test.db?psow=$psow
        execsql "
          PRAGMA key = $hexkey;
          PRAGMA cipher_page_size = $page_sz;
          PRAGMA journal_mode = $mode;
          PRAGMA synchronous = $sync;
          PRAGMA wal_autocheckpoint = 0;
          PRAGMA cache_size = 0;
          CREATE TABLE t1(a INTEGER PRIMARY KEY, b);
          INSERT INTO t1 VALUES(1, zeroblob(500));
          BEGIN;
        "
        for {set i 2} {$i <= $rows} {incr i} {
          execsql "INSERT INTO t1 VALUES($i, zeroblob(2000))"
        }

        execsql { COMMIT; }

        forcecopy test.db test2.db

        if {[file exists test.db-wal]} {
          forcecopy test.db-wal test2.db-wal
        }
        if {[file exists test.db-journal]} {
          forcecopy test.db-journal test2.db-journal
        }
        db close

        sqlite_orig db file:test2.db?psow=$psow
        execsql "
          PRAGMA key = $hexkey;
          PRAGMA cipher_page_size = $page_sz;
          PRAGMA integrity_check;
          SELECT count(*) FROM t1;
        "
      } "ok ok $rows"
      db close
      forcedelete test.db test.db-journal test.db-wal test.db-shm
      forcedelete test2.db test2.db-journal test2.db-wal test2.db-shm

      # if a transaction is not committed, verify it is rolled
      # back as part of the recovery process
      do_test recover-uncommitted-$mode-$page_sz-$psow {
        sqlite_orig db file:test.db?psow=$psow
        execsql "
          PRAGMA key = $hexkey;
          PRAGMA cipher_page_size = $page_sz;
          PRAGMA journal_mode = $mode;
          PRAGMA synchronous = $sync;
          PRAGMA wal_autocheckpoint = 0;
          PRAGMA cache_size = 0;
          CREATE TABLE t1(a INTEGER PRIMARY KEY, b);
          INSERT INTO t1 VALUES(1, zeroblob(500));
          BEGIN;
        "
        for {set i 2} {$i <= $rows} {incr i} {
          execsql "INSERT INTO t1 VALUES($i, zeroblob(2000))"
        }

        # do not commit transaction

        forcecopy test.db test2.db

        if {[file exists test.db-wal]} {
          forcecopy test.db-wal test2.db-wal
        }
        if {[file exists test.db-journal]} {
          forcecopy test.db-journal test2.db-journal
        }
        db close

        sqlite_orig db file:test2.db?psow=$psow
        execsql "
          PRAGMA key = $hexkey;
          PRAGMA cipher_page_size = $page_sz;
          PRAGMA integrity_check;
          SELECT count(*) FROM t1;
        "
      } {ok ok 1}
      db close
      forcedelete test.db test.db-journal test.db-wal test.db-shm
      forcedelete test2.db test2.db-journal test2.db-wal test2.db-shm

      # Use of an incorrect key should fail recovery
      do_test recover-bad-key-$mode-$page_sz-$psow {
        sqlite_orig db file:test.db?psow=$psow
        execsql "
          PRAGMA key = $hexkey;
          PRAGMA cipher_page_size = $page_sz;
          PRAGMA journal_mode = $mode;
          PRAGMA synchronous = $sync;
          PRAGMA wal_autocheckpoint = 0;
          PRAGMA cache_size = 0;
          CREATE TABLE t1(a INTEGER PRIMARY KEY, b);
          INSERT INTO t1 VALUES(1, zeroblob(500));
          PRAGMA wal_checkpoint = FULL;
          BEGIN;
        "
        for {set i 2} {$i <= $rows} {incr i} {
          execsql "INSERT INTO t1 VALUES($i, zeroblob(2000))"
        }

        execsql { COMMIT; }

        forcecopy test.db test2.db

        if {[file exists test.db-wal]} {
          forcecopy test.db-wal test2.db-wal
        }
        if {[file exists test.db-journal]} {
          forcecopy test.db-journal test2.db-journal
        }
        db close

        # unable to open file get error
        sqlite_orig db file:test2.db?psow=$psow
        set err [lindex [catchsql "
          PRAGMA key = $hexkey2;
          PRAGMA cipher_page_size = $page_sz;
          SELECT count(*) FROM t1;
        "] 0]

        set success [execsql "
          PRAGMA key = $hexkey;
          PRAGMA cipher_page_size = $page_sz;
          SELECT count(*) FROM t1;
        "]

        list $err $success
      } "1 {ok $rows}"
      db close
      forcedelete test.db test.db-journal test.db-wal test.db-shm
      forcedelete test2.db test2.db-journal test2.db-wal test2.db-shm

      # Pages in the journal can be reused. Execute two update statements in one transaction
      # that will update the same pages. This should cause the frames to be rewritten.
      do_test recover-reuse-$mode-$page_sz-$psow {
        sqlite_orig db file:test.db?psow=$psow
        execsql "
          PRAGMA key = $hexkey;
          PRAGMA cipher_page_size = $page_sz;
          PRAGMA journal_mode = $mode;
          PRAGMA synchronous = $sync;
          PRAGMA wal_autocheckpoint = 0;
          PRAGMA cache_size = 0;
          CREATE TABLE t1(a INTEGER PRIMARY KEY, b);
          INSERT INTO t1 VALUES(1, zeroblob(500));
          BEGIN;
        "
        for {set i 2} {$i <= $rows} {incr i} {
          execsql "INSERT INTO t1 VALUES($i, zeroblob(2000))"
        }

        execsql { COMMIT; }
        execsql {
          BEGIN;
          UPDATE t1 SET b = randomblob(2001);
          UPDATE t1 SET b = randomblob(2002);
          COMMIT;
        }

        forcecopy test.db test2.db

        if {[file exists test.db-wal]} {
          forcecopy test.db-wal test2.db-wal
        }
        if {[file exists test.db-journal]} {
          forcecopy test.db-journal test2.db-journal
        }
        db close

        sqlite_orig db file:test2.db?psow=$psow
        execsql "
          PRAGMA key = $hexkey;
          PRAGMA cipher_page_size = $page_sz;
          PRAGMA integrity_check;
          SELECT count(*), min(length(b)) FROM t1;
        "

      } "ok ok $rows 2002"
      db close
      forcedelete test.db test.db-journal test.db-wal test.db-shm
      forcedelete test2.db test2.db-journal test2.db-wal test2.db-shm

    }
  }
}

# corrupt the last last frame by overwriting it with (16 bytes of
# page data overwritten), verify the frame is rejected based on the
# and recovers to the previous commit. As above, crashes sumulated by 
# copy like SQLite WAL tests
do_test recover-corrupt-frame-wal {
  sqlite_orig db test.db
  set rc {}

  execsql "
    PRAGMA key = $hexkey;
    PRAGMA journal_mode = WAL;
    PRAGMA wal_autocheckpoint = 0;
    CREATE TABLE t1(a INTEGER PRIMARY KEY, b);
    INSERT INTO t1 VALUES(1, randomblob(500));
    INSERT INTO t1 VALUES(2, randomblob(500));
  "

  forcecopy test.db test2.db
  forcecopy test.db-wal test2.db-wal
  db close

  # last frame is the commit frame of the second insert 
  set nframe [expr {([file size test2.db-wal] - 32) / $frsz}]
  lappend rc [expr {$nframe > 1}]
  hexio_write test2.db-wal [expr {32 + ($nframe - 1) * $frsz + 24 + 1000}] 0123456789abcdef0123456789abcdef

  sqlite_orig db test2.db
  lappend rc [execsql "
    PRAGMA key = $hexkey;
    PRAGMA integrity_check;
    SELECT count(*) FROM t1;
  "]
} {1 {ok ok 1}}
db close

# reopen to make sure the close did not discard the wal
do_test recover-corrupt-frame-reopen-wal {
  sqlite_orig db test2.db
  execsql "
    PRAGMA key = $hexkey;
    SELECT count(*) FROM t1;
  "
} {ok 1}
db close
forcedelete test.db test.db-journal test.db-wal test.db-shm
forcedelete test2.db test2.db-journal test2.db-wal test2.db-shm

# with synchronous = OFF, record count is set to FFFFFFFF so count of records
# in a journal is by file size.  Disable synchronous and corrup the last
# record in the journal. verify it gets rejected but good records are rolled back properly
do_test recover-corrupt-journal-record-delete {
  sqlite_orig db test.db
  set rc {}

  execsql "
    PRAGMA key = $hexkey;
    PRAGMA journal_mode = DELETE;
    PRAGMA synchronous = OFF;
    PRAGMA cache_size = 0;
    CREATE TABLE t1(a INTEGER PRIMARY KEY, b);
    INSERT INTO t1 VALUES(1, zeroblob(500));
    BEGIN;
    WITH RECURSIVE counter(x) AS (VALUES (2) UNION SELECT x+1 FROM counter WHERE x < 50)
      INSERT INTO t1(a,b) SELECT x, zeroblob(2000) FROM counter;
  "
  # do not commit transaction
  forcecopy test.db test2.db
  forcecopy test.db-journal test2.db-journal
  db close

  # check record count will use file size for record
  lappend rc [hexio_read test2.db-journal 8 4]

  # append a record with junk pagedata and bad checksum
  hexio_write test2.db-journal [file size test2.db-journal] \
    [format %08X 2][string repeat 5A $pgsz]00000000

  sqlite_orig db test2.db
  lappend rc [execsql "
    PRAGMA key = $hexkey;
    PRAGMA integrity_check;
    SELECT count(*) FROM t1;
  "]
} {FFFFFFFF {ok ok 1}}
db close

# reopen the same copy to verify the outcome persists across connections
do_test recover-corrupt-journal-record-reopen-delete {
  sqlite_orig db test2.db
  execsql "
    PRAGMA key = $hexkey;
    SELECT count(*) FROM t1;
  "
} {ok 1}
db close
forcedelete test.db test.db-journal test.db-wal test.db-shm
forcedelete test2.db test2.db-journal test2.db-wal test2.db-shm

# simulate a crash with committed but un-checkpointed frames in the WAL with the next
# reopen using a bad key and closes. The wal should remain
# after the close and open with the right key

do_test recover-bad-key-close-wal {
  sqlite_orig db test.db
  set rc {}

  execsql "
    PRAGMA key = $hexkey;
    PRAGMA journal_mode = WAL;
    PRAGMA wal_autocheckpoint = 0;
    CREATE TABLE t1(a INTEGER PRIMARY KEY, b);
    INSERT INTO t1 VALUES(1, zeroblob(500));
    INSERT INTO t1 VALUES(2, zeroblob(500));
  "

  forcecopy test.db test2.db
  forcecopy test.db-wal test2.db-wal
  db close

  sqlite_orig db test2.db
  lappend rc [catchsql "
    PRAGMA key = $hexkey2;
    SELECT count(*) FROM t1;
  "]
  db close

  # file will only exist under VFS
  lappend rc [file exists test2.db-wal]

  sqlite_orig db test2.db
  lappend rc [execsql "
    PRAGMA key = $hexkey;
    SELECT count(*) FROM t1;
  "]
} "{1 {file is not a database}} $sqlcipherVfs {ok 2}"
db close
forcedelete test.db test.db-journal test.db-wal test.db-shm
forcedelete test2.db test2.db-journal test2.db-wal test2.db-shm

# similar to above, crash leaves a hot rollback journal for a transaction that 
# rewrote pages. If the next connection opens with an incorrect key the journal
# should survive. The following open after that should see original data.
# note that in the latter half of the test, test2.db-journal will only exist
# if SQLCipher VFS is being used, recover runs do not require the correct key 
do_test recover-bad-key-retry-delete {
  sqlite_orig db test.db
  set rc {}

  execsql "
    PRAGMA key = $hexkey;
    PRAGMA journal_mode = DELETE;
    PRAGMA cache_size = 0;
    CREATE TABLE t1(a INTEGER PRIMARY KEY, b);
    WITH RECURSIVE counter(x) AS (VALUES (1) UNION SELECT x+1 FROM counter WHERE x < 50)
      INSERT INTO t1(a,b) SELECT x, zeroblob(2000) FROM counter;
  "

  execsql {
    BEGIN;
    UPDATE t1 SET b = zeroblob(2001);
    DELETE FROM t1 WHERE a > 25;
  }

  # don't commit
  forcecopy test.db test2.db
  forcecopy test.db-journal test2.db-journal
  db close

  sqlite_orig db test2.db
  lappend rc [catchsql "
    PRAGMA key = $hexkey2;
    SELECT count(*) FROM t1;
  "]
  lappend rc [catchsql {
    SELECT count(*) FROM t1;
  }]
  db close

  # file will only exist under VFS
  lappend rc [file exists test2.db-journal]

  sqlite_orig db test2.db
  lappend rc [execsql "
    PRAGMA key = $hexkey;
    PRAGMA integrity_check;
    SELECT sum(length(b)), count(*) FROM t1;
  "]
} "{1 {file is not a database}} {1 {file is not a database}} $sqlcipherVfs {ok ok 100000 50}"
db close
forcedelete test.db test.db-journal test.db-wal test.db-shm
forcedelete test2.db test2.db-journal test2.db-wal test2.db-shm

# overflow pages of a zeroblob will be all zero except for the next
# pointer which isn't summed. likewise a if page fails to decrypt sqlcipher zeros the buffer
# so its computed checksum would actually match the the stored one the code in the
# sqlcipher VFS manually forces a mismatch.

do_test recover-corrupt-journal-zero-cksum-delete {
  sqlite_orig db test.db
  set rc {}

  execsql "
    PRAGMA key = $hexkey;
    PRAGMA journal_mode = DELETE;
    PRAGMA synchronous = OFF;
    CREATE TABLE t1(a INTEGER PRIMARY KEY, b);
    INSERT INTO t1 VALUES(1, zeroblob(30000));
    BEGIN;
    UPDATE t1 SET b = zeroblob(9000) || x'01' || zeroblob(20999);
  "
  forcecopy test.db test2.db
  forcecopy test.db-journal test2.db-journal
  db close

  # 512 byte header, a record for page 2, then overflow page 3
  lappend rc [file size test2.db-journal]

  # in order for a journal record to be interpreted as corrup for both VFS and the CODEC
  #  the corruption must affect bytes that will be used to caclulate the checksum itself
  # which would be page_sz - a multiple of 200
  for {set i 1} {$i <= 3} {incr i} {
    hexio_write test2.db-journal [expr {512 + 8200 + 4 + (8192 - (200*$i)) }] 00
  }

  sqlite_orig db test2.db
  lappend rc [execsql "
    PRAGMA key = $hexkey;
    PRAGMA integrity_check;
  "]
} {16912 {ok ok}}
db close
forcedelete test.db test.db-journal test2.db test2.db-journal

# similar to the journal case, if a corrupt frame is zeroed by the VFS
# the VFS inverts its salts to force a mismatch, so build a WAL with one
# garbage frame for page 2 that has exactly that checksum. Zero salts
# would still match if they were cleared. The key must be used before
# recovery, or the decrypt failure means a wrong key.
do_test recover-corrupt-frame-zero-cksum-wal {
  sqlite_orig db test.db
  execsql "
    PRAGMA key = $hexkey;
    PRAGMA journal_mode = WAL;
    CREATE TABLE t1(a INTEGER PRIMARY KEY, b);
    PRAGMA wal_checkpoint(TRUNCATE);
  "

  # built as in wal.test wal-18.2, but the checksum covers a zeroed page
  set walhdr [binary format IIIIII 931071618 3007000 $pgsz 0 0 0]
  set c1 0
  set c2 0
  wal_cksum little c1 c2 $walhdr
  append walhdr [binary format II $c1 $c2]
  wal_cksum little c1 c2 [binary format II 2 2]
  wal_cksum little c1 c2 [string repeat \0 $pgsz]
  set framehdr [binary format IIIIII 2 2 0 0 $c1 $c2]

  set fd [open test.db-wal w]
  fconfigure $fd -translation binary

  # write zeros (invalid encrypted page data) after the wal header and frame header
  puts -nonewline $fd $walhdr$framehdr[string repeat 0 $pgsz]
  close $fd

  # as in wal2-9.x, overwrite the wal-index header of the -shm file to 
  # force the current connection to run wal recovery, which should
  # disregard the first frame
  hexio_write test.db-shm 0 [string repeat 00 96]

  execsql {
    PRAGMA integrity_check;
    SELECT count(*) FROM t1;
  }
} {ok 0}
db close
forcedelete test.db test.db-wal test.db-shm

# a corrup first frame is the first page decrypted during recovery, so
# the key has not been used yet. SQLCipher should verify the key against
# page 1 of the database instead and discard the frame, not report a bad key
do_test recover-corrupt-first-frame-wal {
  sqlite_orig db test.db
  execsql "
    PRAGMA key = $hexkey;
    CREATE TABLE t1(a INTEGER PRIMARY KEY, b);
    PRAGMA journal_mode = WAL;
    PRAGMA wal_autocheckpoint = 0;
    INSERT INTO t1 VALUES(1, 'x');
  "
  forcecopy test.db test2.db
  forcecopy test.db-wal test2.db-wal
  db close

  # the only frame is the commit frame for page 2
  hexio_write test2.db-wal [expr {32 + 24 + 1000}] 0123456789abcdef0123456789abcdef

  sqlite_orig db test2.db
  execsql "
    PRAGMA key = $hexkey;
    PRAGMA integrity_check;
    SELECT count(*) FROM t1;
  "
} {ok ok 0}
db close
forcedelete test.db test.db-wal test.db-shm
forcedelete test2.db test2.db-wal test2.db-shm

# same as above for a hot journal with a single corrupt record. the update is
# not spilled, so discarding the record leaves the original row
do_test recover-corrupt-first-record-delete {
  sqlite_orig db test.db
  set rc {}

  execsql "
    PRAGMA key = $hexkey;
    PRAGMA journal_mode = DELETE;
    PRAGMA synchronous = OFF;
    CREATE TABLE t1(a INTEGER PRIMARY KEY, b);
    INSERT INTO t1 VALUES(1, 'x');
    BEGIN;
    UPDATE t1 SET b = 'y';
  "
  forcecopy test.db test2.db
  forcecopy test.db-journal test2.db-journal
  db close

  # 512 byte header and one record
  lappend rc [file size test2.db-journal]

  # in order for a journal record to be interpreted as corrup for both VFS and the CODEC
  #  the corruption must affect bytes that will be used to caclulate the checksum itself
  # which would be page_sz - a multiple of 200
  for {set i 1} {$i <= 3} {incr i} {
    hexio_write test2.db-journal [expr {512 + 4 + (8192 - (200*$i)) }] 0000
  }

  sqlite_orig db test2.db
  lappend rc [execsql "
    PRAGMA key = $hexkey;
    PRAGMA integrity_check;
    SELECT b FROM t1;
  "]
} {8712 {ok ok x}}
db close
forcedelete test.db test.db-journal test2.db test2.db-journal

# corrupt a frame in the middle of the WAL. recovery stops at the bad frame
# so the commits after it are discarded along with it, even though their
# frames are valid. only the first commit survives
do_test recover-corrupt-mid-frame-wal {
  sqlite_orig db test.db
  set rc {}

  execsql "
    PRAGMA key = $hexkey;
    CREATE TABLE t1(a INTEGER PRIMARY KEY, b);
    PRAGMA journal_mode = WAL;
    PRAGMA wal_autocheckpoint = 0;
    INSERT INTO t1 VALUES(1, 'x');
    INSERT INTO t1 VALUES(2, 'y');
    INSERT INTO t1 VALUES(3, 'z');
  "
  forcecopy test.db test2.db
  forcecopy test.db-wal test2.db-wal
  db close

  # one frame for page 2 per commit, corrupt the second
  lappend rc [file size test2.db-wal]
  hexio_write test2.db-wal [expr {32 + $frsz + 24 + 1000}] 0123456789abcdef0123456789abcdef

  sqlite_orig db test2.db
  lappend rc [execsql "
    PRAGMA key = $hexkey;
    PRAGMA integrity_check;
    SELECT a FROM t1;
  "]
} [list [expr {32 + 3 * $frsz}] {ok ok 1}]
db close
forcedelete test.db test.db-wal test.db-shm
forcedelete test2.db test2.db-wal test2.db-shm

# a plaintext header migration in WAL mode writes page 1 to the WAL only,
# so until a checkpoint page 1 in the database file still starts with the
# salt. If the migration frame is corrupted, the key check for page 1 should
# use the default offset when checking the key against the main database
# file
do_test recover-corrupt-first-frame-plaintext-header-wal {
  sqlite_orig db test.db
  set rc {}

  execsql "
    PRAGMA key = $hexkey;
    CREATE TABLE t1(a,b);
    PRAGMA journal_mode = WAL;
    PRAGMA wal_autocheckpoint = 0;
    PRAGMA cipher_plaintext_header_size = 32;
    PRAGMA user_version = 1;
  "
  forcecopy test.db test2.db
  forcecopy test.db-wal test2.db-wal
  db close

  # database file still starts with the salt, the WAL holds only page 1
  lappend rc [hexio_read test2.db 0 4] [file size test2.db-wal]
  hexio_write test2.db-wal [expr {32 + 24 + 1000}] 0123456789abcdef0123456789abcdef

  sqlite_orig db test2.db
  lappend rc [catchsql "
    PRAGMA key = $hexkey;
    PRAGMA cipher_plaintext_header_size = 32;
    PRAGMA user_version;
  "]
} [list 01010101 [expr {32 + $frsz}] {0 {ok 0}}]
db close
forcedelete test.db test.db-wal test.db-shm
forcedelete test2.db test2.db-wal test2.db-shm

# simulate a crash after a rekey and a commit after it. A second connection holds a read transaction on the checkpointed database,
# which blocks the checkpoint at the end of the rekey, so the WAL keeps both rekey frames and the commit, and
# recovery must complete under the new key
do_test recover-rekey-wal {
  sqlite_orig db test.db
  set rc {}

  execsql "
    PRAGMA key = $hexkey;
    PRAGMA journal_mode = WAL;
    PRAGMA wal_autocheckpoint = 0;
    CREATE TABLE t1(a INTEGER PRIMARY KEY, b);
    INSERT INTO t1 VALUES(1, zeroblob(500));
    PRAGMA wal_checkpoint(TRUNCATE);
  "

  # connection 2 holds read lock
  sqlite_orig db2 test.db
  execsql "
    PRAGMA key = $hexkey;
    BEGIN;
    SELECT count(*) FROM t1;
  " db2

  execsql "
    PRAGMA rekey = $hexkey2;
    INSERT INTO t1 VALUES(2, zeroblob(500));
  "
  forcecopy test.db test2.db
  forcecopy test.db-wal test2.db-wal
  db close
  db2 close

  lappend rc [file size test2.db-wal]

  sqlite_orig db test2.db
  lappend rc [execsql "
    PRAGMA key = $hexkey2;
    SELECT count(*) FROM t1;
    PRAGMA integrity_check;
  "]
} [list [expr {32 + 3 * $frsz}] {ok 2 ok}]
db close
forcedelete test.db test.db-wal test.db-shm
forcedelete test2.db test2.db-wal test2.db-shm

# simulate a crash after a rekey fails part way through. cache_size = 0
# spills pages under the new key to the WAL without a commit, so
# recovery with the original key must discard those frames
do_test recover-rekey-error-wal {
  sqlite_orig db test.db
  set rc {}

  execsql "
    PRAGMA key = $hexkey;
    PRAGMA journal_mode = WAL;
    CREATE TABLE t1(a INTEGER PRIMARY KEY, b);
    WITH RECURSIVE c(x) AS (VALUES(1) UNION ALL SELECT x+1 FROM c WHERE x < 500)
      INSERT INTO t1 SELECT x, zeroblob(5000) FROM c;
    PRAGMA cipher_test_on = fail_rekey;
  "
  lappend rc [catchsql "
    PRAGMA cache_size = 0;
    PRAGMA rekey = $hexkey2;
  "]
  forcecopy test.db test2.db
  forcecopy test.db-wal test2.db-wal
  db close

  sqlite_orig db test2.db
  lappend rc [execsql "
    PRAGMA key = $hexkey;
    PRAGMA cipher_test_off = fail_rekey;
    SELECT count(*) FROM t1;
    PRAGMA integrity_check;
  "]
} {{1 {An error occurred with PRAGMA key or rekey.}} {ok 500 ok}}
db close
forcedelete test.db test.db-wal test.db-shm
forcedelete test2.db test2.db-wal test2.db-shm

finish_test
